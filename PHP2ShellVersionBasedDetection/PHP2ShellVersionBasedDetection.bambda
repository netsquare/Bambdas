id: 8f018f0c-1ee9-410a-abb4-abcf8b2af89f
name: PHP2ShellVersionBasedDetection
function: CUSTOM_ACTION
location: REPEATER
source: "logging.logToOutput(\"----- PHP2Shell - Version Based Detection -----\");\n\
  if (requestResponse.response() == null) {\r\n    logging.logToOutput(\"[ERROR] No\
  \ response available. Send a request before running this action.\");\r\n    return;\r\
  \n}\r\nvar versionPattern = Pattern.compile(\"\\\\bPHP(?:\\\\s*/\\\\s*|\\\\s+)(\\\
  \\d+)\\\\.(\\\\d+)(?:\\\\.(\\\\d+))?\\\\b\", Pattern.CASE_INSENSITIVE);\nfor (var\
  \ header : requestResponse.response().headers()) {\r\n    String headerName = header.name();\r\
  \n    if (headerName.equalsIgnoreCase(\"X-Powered-By\") || headerName.equalsIgnoreCase(\"\
  Server\") || headerName.equalsIgnoreCase(\"X-PHP-Version\")) {\r\n        var matcher\
  \ = versionPattern.matcher(header.value());\n        if (matcher.find()) {\n   \
  \         String detectedVersion = matcher.group(1) + \".\" + matcher.group(2);\n\
  \            boolean hasPatch = matcher.group(3) != null;\n            if (hasPatch)\
  \ detectedVersion += \".\" + matcher.group(3);\n            if (!hasPatch) {\n \
  \               logging.logToOutput(\"[INFO] Incomplete PHP version disclosed\"\
  \ + \"\\n\\tVersion: \" + detectedVersion + \"\\n\\tHeader: \" + headerName);\n\
  \                continue;\n            }\n            try {\n                int\
  \ major = Integer.parseInt(matcher.group(1));\r\n                int minor = Integer.parseInt(matcher.group(2));\n\
  \                int patch = Integer.parseInt(matcher.group(3));\r\n           \
  \     if (major < 8 || (major == 8 && minor < 2)) {\n                    logging.logToOutput(\"\
  Legacy PHP Branch:\\n\\tVersion: \" + detectedVersion + \"\\n\\tHeader: \" + headerName\
  \ + \"\\n\\tFix: No longer supported by PHP project. Verify vendor backports or\
  \ upgrade to a supported, patched PHP release.\");\n                } else if (major\
  \ == 8 && minor == 2 && patch < 35) {\r\n                   logging.logToOutput(\"\
  Vulnerable PHP Version Detected (PHP2Shell)\\n\\tVersion: \" + detectedVersion +\
  \ \"\\n\\tHeader: \" + headerName + \"\\n\\tFix: Upgrade to PHP 8.2.35 or the vendor's\
  \ equivalent patched build.\");\r\n                } else if (major == 8 && minor\
  \ == 3 && patch < 36) {\r\n                   logging.logToOutput(\"Vulnerable PHP\
  \ Version Detected (PHP2Shell)\\n\\tVersion: \" + detectedVersion + \"\\n\\tHeader:\
  \ \" + headerName + \"\\n\\tFix: Upgrade to PHP 8.3.36 or the vendor's equivalent\
  \ patched build.\");\r\n                } else if (major == 8 && minor == 4 && patch\
  \ < 27) {\r\n                   logging.logToOutput(\"Vulnerable PHP Version Detected\
  \ (PHP2Shell)\\n\\tVersion: \" + detectedVersion + \"\\n\\tHeader: \" + headerName\
  \ + \"\\n\\tFix: Upgrade to PHP 8.4.27 or the vendor's equivalent patched build.\"\
  );\r\n                } else if (major == 8 && minor == 5 && patch < 12) {\r\n \
  \                  logging.logToOutput(\"Vulnerable PHP Version Detected (PHP2Shell)\\\
  n\\tVersion: \" + detectedVersion + \"\\n\\tHeader: \" + headerName + \"\\n\\tFix:\
  \ Upgrade to PHP 8.5.12 or the vendor's equivalent patched build.\");\r\n      \
  \          } else if ((major == 8 && minor == 2 && patch >= 35) || (major == 8 &&\
  \ minor == 3 && patch >= 36) || (major == 8 && minor == 4 && patch >= 27) || (major\
  \ == 8 && minor == 5 && patch >= 12)) {\n                    logging.logToOutput(\"\
  [INFO] At or Above Known Fixed Threshold\" + \"\\n\\tVersion: \" + detectedVersion\
  \ + \"\\n\\tHeader: \" + headerName + \"\\n\\tNote: Verify vendor backports and\
  \ applicable security advisories.\");\n                } else {\n              \
  \      logging.logToOutput(\"[INFO] PHP Version Not Classified\" + \"\\n\\tVersion:\
  \ \" + detectedVersion + \"\\n\\tHeader: \" + headerName + \"\\n\\tNote: Verify\
  \ against the applicable PHP security advisory.\");\n                }\n       \
  \     } catch (NumberFormatException e) {\n                logging.logToOutput(\"\
  [ERROR] Could not parse PHP version from header: \" + headerName);\n           \
  \ }\n        }\n    }\r\n}"
